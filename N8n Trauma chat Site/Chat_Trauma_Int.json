{
  "name": "Chat_Trauma_Int",
  "nodes": [
    {
      "parameters": {
        "options": {
          "mode": "embedded",
          "responseMode": "usingResponseNodes",
          "streaming": true
        }
      },
      "id": "c1",
      "name": "Chat Trigger",
      "type": "n8n-nodes-langchain.chattrigger",
      "typeVersion": 1,
      "position": [200, 200]
    },
    {
      "parameters": {
        "amount": 7,
        "unit": "seconds"
      },
      "id": "c2",
      "name": "Wait Initial 7s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [420, 200]
    },
    {
      "parameters": {
        "operation": "getAll",
        "schema": "public",
        "table": "sector",
        "filters": [
          {"column":"active","operator":"eq","value":true}
        ],
        "limit": 100
      },
      "id": "c3",
      "name": "List Sectors",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [640, 200]
    },
    {
      "parameters": {
        "functionCode": "const rows = items[0]?.json?.data || items.map(i => i.json);\nlet msg = 'Bem-vindo! Escolha um setor para atendimento:\n';\nrows.forEach((s, i) => { msg += `${i+1}. ${s.name}${s.description? ' - '+s.description: ''}\n`; });\nreturn [{ json: { message: msg, sectors: rows } }];"
      },
      "id": "c4",
      "name": "Format Message",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [860, 200]
    },
    {
      "parameters": {
        "message": "={{$json.message}}",
        "waitForUserReply": true,
        "options": {"enableStreaming": true}
      },
      "id": "c5",
      "name": "Respond List",
      "type": "n8n-nodes-langchain.respondtochat",
      "typeVersion": 1,
      "position": [1080, 200]
    },
    {
      "parameters": {
        "functionCode": "const sectors = $prevNode('Format Message').item.json.sectors || [];\nconst input = ($json.response || $json.text || $json.message || '').trim();\nconst n = parseInt(input, 10);\nlet selected = null;\nif (!isNaN(n) && n>=1 && n<=sectors.length) selected = sectors[n-1];\nelse selected = sectors.find(s => (s.name||'').toLowerCase() === input.toLowerCase());\nif (!selected) return [{ json: { error: 'Seleção inválida. Informe o número ou o nome do setor.' } }];\nreturn [{ json: { sectorId: selected.id, sectorName: selected.name, vector_namespace: selected.vector_namespace || 'default', workflow_id: selected.workflow_id || null } }];"
      },
      "id": "c6",
      "name": "Parse Selection",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1300, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {"value1": "={{$json.error}}", "operation": "isEmpty"}
          ]
        }
      },
      "id": "c7",
      "name": "If Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1520, 200]
    },
    {
      "parameters": {
        "amount": 7,
        "unit": "seconds"
      },
      "id": "c8",
      "name": "Wait Invalid 7s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1520, 360]
    },
    {
      "parameters": {
        "message": "={{$json.error}}",
        "waitForUserReply": true,
        "options": {"enableStreaming": true}
      },
      "id": "c9",
      "name": "Respond Invalid",
      "type": "n8n-nodes-langchain.respondtochat",
      "typeVersion": 1,
      "position": [1740, 360]
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {"name":"sectorId","value":"={{$json.sectorId}}"},
            {"name":"sectorName","value":"={{$json.sectorName}}"},
            {"name":"vector_namespace","value":"={{$json.vector_namespace}}"},
            {"name":"userId","value":"={{$json.metadata?.userId || 'anon'}}"}
          ]
        }
      },
      "id": "c10",
      "name": "Set Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1740, 200]
    },
    {
      "parameters": {
        "functionCode": "function randDigit(){ return Math.floor(Math.random()*10).toString(); }\nconst name = $json.sectorName || 'SET';\nconst prefix = (name.normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toUpperCase().replace(/[^A-Z]/g,'').slice(0,3) || 'SET').padEnd(3,'X');\nconst d = new Date();\nconst yy = (d.getFullYear()%100).toString().padStart(2,'0');\nconst MM = (d.getMonth()+1).toString().padStart(2,'0');\nconst dd = d.getDate().toString().padStart(2,'0');\nconst HH = d.getHours().toString().padStart(2,'0');\nconst digits = yy+MM+dd+HH + randDigit();\nreturn [{ json: { ticket: `${prefix}${digits}`, sector_id: $json.sectorId, sector_name: name, user_id: $json.userId, created_at: d.toISOString() } }];"
      },
      "id": "c11",
      "name": "Generate Ticket",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1960, 200]
    },
    {
      "parameters": {
        "operation": "getAll",
        "schema": "public",
        "table": "tickets",
        "filters": [
          {"column":"ticket","operator":"eq","value":"={{$json.ticket}}"}
        ],
        "limit": 1
      },
      "id": "c12",
      "name": "Ticket Check Exists",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2180, 200]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {"value1":"={{Array.isArray($json.data)? $json.data.length : 0}}","operation":"smaller","value2":1}
          ]
        }
      },
      "id": "c13",
      "name": "If Unique",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2400, 200]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "tickets",
        "data": {
          "ticket": "={{$json.ticket}}",
          "sector_id": "={{$json.sector_id}}",
          "sector_name": "={{$json.sector_name}}",
          "user_id": "={{$json.user_id}}",
          "created_at": "={{$json.created_at}}"
        }
      },
      "id": "c14",
      "name": "Save Ticket",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2620, 200]
    },
    {
      "parameters": {
        "operation": "getAll",
        "schema": "public",
        "table": "leads",
        "filters": [
          {"column":"user_id","operator":"eq","value":"={{$json.user_id}}"}
        ],
        "limit": 1
      },
      "id": "c15",
      "name": "Get Lead By User",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2840, 200]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {"value1":"={{Array.isArray($json.data)? $json.data.length : 0}}","operation":"greaterOrEqual","value2":1}
          ]
        }
      },
      "id": "c16",
      "name": "If Lead Exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [3060, 200]
    },
    {
      "parameters": {
        "operation": "updateMany",
        "schema": "public",
        "table": "leads",
        "filters": [
          {"column":"user_id","operator":"eq","value":"={{$json.user_id}}"}
        ],
        "data": {
          "sector_id": "={{$json.sector_id}}",
          "sector_name": "={{$json.sector_name}}",
          "current_ticket": "={{$json.ticket}}"
        }
      },
      "id": "c17",
      "name": "Update Lead",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [3280, 140]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "leads",
        "data": {
          "user_id": "={{$json.user_id}}",
          "sector_id": "={{$json.sector_id}}",
          "sector_name": "={{$json.sector_name}}",
          "current_ticket": "={{$json.ticket}}"
        }
      },
      "id": "c18",
      "name": "Insert Lead",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [3280, 260]
    },
    {
      "parameters": {
        "amount": 7,
        "unit": "seconds"
      },
      "id": "c19",
      "name": "Wait Ticket 7s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [3500, 200]
    },
    {
      "parameters": {
        "message": "Seu protocolo é: ={{$json.ticket}}. Como posso ajudar no setor ={{$json.sector_name}}?",
        "options": {"enableStreaming": true}
      },
      "id": "c20",
      "name": "Respond Ticket",
      "type": "n8n-nodes-langchain.respondtochat",
      "typeVersion": 1,
      "position": [3720, 200]
    },
    {
      "parameters": {
        "agentType": "openaiFunctions",
        "options": {"enableStreaming": true}
      },
      "id": "c21",
      "name": "Supervisor Agent",
      "type": "n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [3940, 200]
    },
    {
      "parameters": {
        "amount": 7,
        "unit": "seconds"
      },
      "id": "c22",
      "name": "Wait Final 7s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [4160, 200]
    },
    {
      "parameters": {
        "message": "={{$json.output || $json.message || 'Atendimento concluído.'}}",
        "options": {"enableStreaming": true}
      },
      "id": "c23",
      "name": "Respond Final",
      "type": "n8n-nodes-langchain.respondtochat",
      "typeVersion": 1,
      "position": [4380, 200]
    }
  ],
  "connections": {
